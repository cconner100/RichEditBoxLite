<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android;net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <UnoSingleProject>true</UnoSingleProject>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>CConner100.RichEditBoxLite</PackageId>
    <Version>0.1.0</Version>
    <Authors>Curtis Conner</Authors>
    <Description>A WinUI-shaped RichEditBox control rendered by Uno Platform's Skia renderer.</Description>
    <PackageTags>uno;skia;richeditbox;rich-text;editor</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cconner100/RichEditBoxLite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cconner100/RichEditBoxLite.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Dictionaries/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" />
    <None Include="../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
