<Page
    x:Class="RichEditBoxLite.TestApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rte="using:CConner100.RichEditBoxLite"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*">
        <Border Padding="20,14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="RichEditBoxLite Test UI" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Uno Skia compatibility workbench · English / Español" Opacity="0.7" />
                </StackPanel>
                <TextBlock x:Name="RuntimeStatus" Grid.Column="1"
                           AutomationProperties.AutomationId="RuntimeStatus"
                           Text="● Ready" Foreground="ForestGreen" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <ListView x:Name="SectionList"
                      AutomationProperties.AutomationId="SectionNavigation"
                      SelectionChanged="SectionList_SelectionChanged"
                      SelectedIndex="0">
                <ListViewItem Content="Playground" Tag="Playground" />
                <ListViewItem Content="Formatting &amp; Document" Tag="Formatting" />
                <ListViewItem Content="RTF &amp; Rich Content" Tag="Rtf" />
                <ListViewItem Content="Input &amp; Spellcheck" Tag="Input" />
                <ListViewItem Content="Properties &amp; States" Tag="Properties" />
                <ListViewItem Content="Event Monitor" Tag="Events" />
                <ListViewItem Content="Accessibility &amp; Stress" Tag="Stress" />
            </ListView>

            <ScrollViewer Grid.Column="1">
                <Grid Padding="24" MaxWidth="1100" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="PlaygroundSection" Spacing="14">
                        <TextBlock Text="Playground" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <rte:RichEditBoxLite x:Name="Editor"
                                             AutomationProperties.AutomationId="RichEditor"
                                             AutomationProperties.Name="Rich text notes editor"
                                             AutomationProperties.HelpText="Edits formatted English and Spanish notes"
                                             Header="Notes"
                                             Description="Try formatting, RTF, clipboard and spellcheck."
                                             PlaceholderText="Type English or Spanish text…"
                                             MinHeight="250"
                                             TextChanged="Editor_TextChanged"
                                             TextChanging="Editor_TextChanging"
                                             SelectionChanged="Editor_SelectionChanged"
                                             SelectionChanging="Editor_SelectionChanging"
                                             CopyingToClipboard="Editor_CopyingToClipboard"
                                             CuttingToClipboard="Editor_CuttingToClipboard"
                                             Paste="Editor_Paste"
                                             ContextMenuOpening="Editor_ContextMenuOpening"
                                             CandidateWindowBoundsChanged="Editor_CandidateWindowBoundsChanged"
                                             TextCompositionStarted="Editor_TextCompositionStarted"
                                             TextCompositionChanged="Editor_TextCompositionChanged"
                                             TextCompositionEnded="Editor_TextCompositionEnded" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <TextBlock x:Name="CharacterCount" AutomationProperties.AutomationId="CharacterCount" Text="0 characters" />
                            <TextBlock x:Name="SelectionStatus" Grid.Column="1" AutomationProperties.AutomationId="SelectionStatus" Text="Selection 0:0" />
                            <TextBlock x:Name="FormatStatus" Grid.Column="2" AutomationProperties.AutomationId="FormatStatus" Text="Default format" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="InsertEnglishSample" Content="English sample" Click="InsertEnglishSample_Click" />
                            <Button AutomationProperties.AutomationId="InsertSpanishSample" Content="Muestra española" Click="InsertSpanishSample_Click" />
                            <Button AutomationProperties.AutomationId="ClearDocument" Content="Clear" Click="ClearDocument_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="FormattingSection" Visibility="Collapsed" Spacing="14">
                        <TextBlock Text="Formatting and Document API" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Select text in the Playground, then invoke the same document/range APIs a consumer uses." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="FormatBold" Content="Bold" Click="Bold_Click" />
                            <Button AutomationProperties.AutomationId="FormatItalic" Content="Italic" Click="Italic_Click" />
                            <Button AutomationProperties.AutomationId="FormatUnderline" Content="Underline" Click="Underline_Click" />
                            <Button AutomationProperties.AutomationId="FormatStrike" Content="Strike" Click="Strike_Click" />
                            <Button AutomationProperties.AutomationId="FormatSubscript" Content="Sub" Click="Subscript_Click" />
                            <Button AutomationProperties.AutomationId="FormatSuperscript" Content="Super" Click="Superscript_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Heading1" Content="H1" Click="Heading1_Click" />
                            <Button AutomationProperties.AutomationId="Heading2" Content="H2" Click="Heading2_Click" />
                            <Button AutomationProperties.AutomationId="NormalParagraph" Content="Body" Click="NormalParagraph_Click" />
                            <Button AutomationProperties.AutomationId="ClearFormatting" Content="Clear formatting" Click="ClearFormatting_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="Undo" Content="Undo" Click="Undo_Click" />
                            <Button AutomationProperties.AutomationId="Redo" Content="Redo" Click="Redo_Click" />
                            <Button AutomationProperties.AutomationId="Uppercase" Content="UPPER" Click="Uppercase_Click" />
                            <Button AutomationProperties.AutomationId="Lowercase" Content="lower" Click="Lowercase_Click" />
                            <Button AutomationProperties.AutomationId="FindText" Content="Find 'Uno'" Click="Find_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="AlignLeft" Content="Left" Click="AlignLeft_Click" />
                            <Button AutomationProperties.AutomationId="AlignCenter" Content="Center" Click="AlignCenter_Click" />
                            <Button AutomationProperties.AutomationId="AlignRight" Content="Right" Click="AlignRight_Click" />
                            <Button AutomationProperties.AutomationId="BulletList" Content="• List" Click="BulletList_Click" />
                            <Button AutomationProperties.AutomationId="NumberList" Content="1. List" Click="NumberList_Click" />
                        </StackPanel>
                        <TextBlock x:Name="DocumentApiResult" AutomationProperties.AutomationId="DocumentApiResult" Text="Ready" />
                    </StackPanel>

                    <StackPanel x:Name="RtfSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="RTF and Rich Content" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="RtfText" AutomationProperties.AutomationId="RtfText"
                                 Header="Raw RTF" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="SaveRtf" Content="Export RTF" Click="SaveRtf_Click" />
                            <Button AutomationProperties.AutomationId="LoadRtf" Content="Import RTF" Click="LoadRtf_Click" />
                            <Button AutomationProperties.AutomationId="LoadRichFixture" Content="Rich fixture" Click="LoadRichFixture_Click" />
                            <Button AutomationProperties.AutomationId="MalformedRtf" Content="Malformed fixture" Click="MalformedRtf_Click" />
                            <Button AutomationProperties.AutomationId="InsertImage" Content="Image placeholder" Click="InsertImage_Click" />
                        </StackPanel>
                        <TextBox x:Name="PlainTextView" AutomationProperties.AutomationId="PlainTextView"
                                 Header="Plain-text projection" IsReadOnly="True" AcceptsReturn="True" />
                        <TextBlock Text="Imported RTF tables are normalized to editable text in v1. U+FFFC is used for inline image objects." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="InputSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Input, Clipboard and Spellcheck" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Required Spanish composition: á é í ó ú ü ñ ¿ ¡" FontSize="20" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ProofingLanguageCombo" AutomationProperties.AutomationId="ProofingLanguage"
                                      Header="Proofing language" SelectionChanged="ProofingLanguageCombo_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="en-US" />
                                <ComboBoxItem Content="es-ES" />
                            </ComboBox>
                            <Button AutomationProperties.AutomationId="CheckSpelling" Content="Check spelling" Click="CheckSpelling_Click" />
                            <Button AutomationProperties.AutomationId="IgnoreWord" Content="Ignore selection" Click="IgnoreWord_Click" />
                            <Button AutomationProperties.AutomationId="AddCustomWord" Content="Add selection" Click="AddCustomWord_Click" />
                        </StackPanel>
                        <ListView x:Name="SpellingResults" AutomationProperties.AutomationId="SpellingResults" MinHeight="120" />
                        <TextBlock Text="The hidden native TextBox bridge supplies dead-key, IME, virtual keyboard, and platform command-key input to the Skia document." TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="PropertiesSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Properties and Visual States" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <ToggleSwitch x:Name="AcceptsReturnToggle" AutomationProperties.AutomationId="Property_AcceptsReturn" Header="AcceptsReturn" IsOn="True" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="ReadOnlyToggle" AutomationProperties.AutomationId="Property_IsReadOnly" Header="IsReadOnly" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="SpellCheckToggle" AutomationProperties.AutomationId="Property_IsSpellCheckEnabled" Header="IsSpellCheckEnabled" IsOn="True" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="PredictionToggle" AutomationProperties.AutomationId="Property_IsTextPredictionEnabled" Header="IsTextPredictionEnabled" IsOn="True" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="ColorFontToggle" AutomationProperties.AutomationId="Property_IsColorFontEnabled" Header="IsColorFontEnabled" IsOn="True" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="PreventKeyboardToggle" AutomationProperties.AutomationId="Property_PreventKeyboardDisplayOnProgrammaticFocus" Header="PreventKeyboardDisplayOnProgrammaticFocus" Toggled="PropertyToggle_Toggled" />
                                <ToggleSwitch x:Name="EnabledToggle" AutomationProperties.AutomationId="State_IsEnabled" Header="IsEnabled" IsOn="True" Toggled="PropertyToggle_Toggled" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8">
                                <TextBox x:Name="HeaderValue" AutomationProperties.AutomationId="Property_Header" Header="Header" Text="Notes" TextChanged="PropertyText_TextChanged" />
                                <TextBox x:Name="DescriptionValue" AutomationProperties.AutomationId="Property_Description" Header="Description" Text="Try formatting, RTF, clipboard and spellcheck." TextChanged="PropertyText_TextChanged" />
                                <TextBox x:Name="PlaceholderValue" AutomationProperties.AutomationId="Property_PlaceholderText" Header="PlaceholderText" Text="Type English or Spanish text…" TextChanged="PropertyText_TextChanged" />
                                <NumberBox x:Name="MaxLengthValue" AutomationProperties.AutomationId="Property_MaxLength" Header="MaxLength (0 = unlimited)" Value="0" ValueChanged="MaxLengthValue_ValueChanged" />
                                <ComboBox x:Name="WrappingCombo" AutomationProperties.AutomationId="Property_TextWrapping" Header="TextWrapping" SelectedIndex="1" SelectionChanged="PropertyCombo_SelectionChanged">
                                    <ComboBoxItem Content="NoWrap" /><ComboBoxItem Content="Wrap" /><ComboBoxItem Content="WrapWholeWords" />
                                </ComboBox>
                                <ComboBox x:Name="CasingCombo" AutomationProperties.AutomationId="Property_CharacterCasing" Header="CharacterCasing" SelectedIndex="0" SelectionChanged="PropertyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Normal" /><ComboBoxItem Content="Lower" /><ComboBoxItem Content="Upper" />
                                </ComboBox>
                                <ComboBox x:Name="AlignmentCombo" AutomationProperties.AutomationId="Property_TextAlignment" Header="TextAlignment" SelectedIndex="0" SelectionChanged="PropertyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Left" /><ComboBoxItem Content="Center" /><ComboBoxItem Content="Right" /><ComboBoxItem Content="Justify" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Retained/no-op compatibility properties" FontWeight="SemiBold" />
                        <ItemsControl x:Name="UnsupportedProperties" AutomationProperties.AutomationId="UnsupportedProperties" />
                        <Button AutomationProperties.AutomationId="ResetProperties" Content="Reset property values" HorizontalAlignment="Left" Click="ResetProperties_Click" />
                    </StackPanel>

                    <StackPanel x:Name="EventsSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Event Monitor" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="ClearEventLog" Content="Clear" Click="ClearEventLog_Click" />
                            <ToggleButton x:Name="PauseEvents" AutomationProperties.AutomationId="PauseEventLog" Content="Pause" />
                            <ToggleSwitch x:Name="CancelSelection" AutomationProperties.AutomationId="CancelSelectionChanging" Header="Cancel SelectionChanging" />
                            <ToggleSwitch x:Name="HandleClipboard" AutomationProperties.AutomationId="HandleClipboardEvents" Header="Handle clipboard events" />
                        </StackPanel>
                        <TextBox x:Name="EventFilter" AutomationProperties.AutomationId="EventFilter" Header="Filter" TextChanged="EventFilter_TextChanged" />
                        <ListView x:Name="EventLog" AutomationProperties.AutomationId="EventLog" MinHeight="360" />
                    </StackPanel>

                    <StackPanel x:Name="StressSection" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Accessibility and Stress" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock AutomationProperties.AutomationId="AccessibilitySummary"
                                   Text="Automation peer: Value + selection/caret metadata. Use Tab/Shift+Tab for keyboard-only focus-order testing." TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button AutomationProperties.AutomationId="StressLongNote" Content="100,000 characters" Click="StressLongNote_Click" />
                            <Button AutomationProperties.AutomationId="StressFormatRuns" Content="Many format runs" Click="StressFormatRuns_Click" />
                            <Button AutomationProperties.AutomationId="StressTable" Content="Table fixture" Click="StressTable_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StressResult" AutomationProperties.AutomationId="StressResult" Text="No fixture loaded." />
                        <ProgressBar x:Name="StressProgress" AutomationProperties.AutomationId="StressProgress" Minimum="0" Maximum="100" />
                        <TextBlock Text="Known runtime gaps: Uno Skia accessibility and IME exposure vary by host; touch-handle and candidate-window placement require device/simulator validation." TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
